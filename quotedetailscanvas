using System;
using System.Collections.Generic;
using System.Linq;
using Microsoft.Xrm.Sdk;
using Microsoft.Xrm.Sdk.Query;
using System.Text.Json;

namespace MyPluginNamespace
{
    public class QuoteDetailSyncPlugin : IPlugin
    {
        public void Execute(IServiceProvider serviceProvider)
        {
            IPluginExecutionContext context = (IPluginExecutionContext)serviceProvider.GetService(typeof(IPluginExecutionContext));
            IOrganizationServiceFactory serviceFactory = (IOrganizationServiceFactory)serviceProvider.GetService(typeof(IOrganizationServiceFactory));
            IOrganizationService service = serviceFactory.CreateOrganizationService(context.UserId);
            ITracingService tracing = (ITracingService)serviceProvider.GetService(typeof(ITracingService));

            try
            {
                if (!context.InputParameters.Contains("QuoteDetailJson"))
                    throw new InvalidPluginExecutionException("Missing QuoteDetailJson input parameter.");

                string jsonString = context.InputParameters["QuoteDetailJson"].ToString();
                var newQuoteDetails = JsonSerializer.Deserialize<List<QuoteDetailInput>>(jsonString);

                if (newQuoteDetails == null || !newQuoteDetails.Any())
                    throw new InvalidPluginExecutionException("QuoteDetailJson is empty or invalid.");

                Guid quoteId = new Guid(newQuoteDetails[0].Quote);
                int newLineCounter = 1;

                foreach (var item in newQuoteDetails)
                {
                    Entity newDetail = new Entity("new_quotedetail");
                    newDetail["new_name"] = item.QuoteDetailName;
                    newDetail["new_quoteid"] = new EntityReference("quote", quoteId);
                    newDetail["new_priceperunit"] = new Money(item.PricePerUnit);
                    newDetail["new_quantity"] = item.Quantity;
                    newDetail["new_linenumber"] = newLineCounter;
                    newDetail["new_recordstarting"] = (newLineCounter == 1);
                    newDetail["new_productname"] = item.ProductName;
                    newDetail["new_productnumber"] = item.ProductNumber;

                    try
                    {
                        QueryExpression productQuery = new QueryExpression("product")
                        {
                            ColumnSet = new ColumnSet("productid"),
                            Criteria = new FilterExpression
                            {
                                Conditions =
                                {
                                    new ConditionExpression("productnumber", ConditionOperator.Equal, item.ProductNumber)
                                }
                            }
                        };

                        EntityCollection productResults = service.RetrieveMultiple(productQuery);
                        if (productResults.Entities.Any())
                        {
                            var product = productResults.Entities.First();
                            newDetail["productid"] = new EntityReference("product", product.Id);
                        }
                    }
                    catch (Exception ex)
                    {
                        tracing.Trace($"Product lookup failed for '{item.ProductNumber}': {ex.Message}");
                    }

                    service.Create(newDetail);
                    newLineCounter++;
                }

                // Reorder all existing quotedetails
                QueryExpression reorderQuery = new QueryExpression("new_quotedetail")
                {
                    ColumnSet = new ColumnSet("new_linenumber", "new_recordstarting"),
                    Criteria = new FilterExpression
                    {
                        Conditions =
                        {
                            new ConditionExpression("new_quoteid", ConditionOperator.Equal, quoteId)
                        }
                    },
                    Orders = { new OrderExpression("new_linenumber", OrderType.Ascending) }
                };

                EntityCollection allDetails = service.RetrieveMultiple(reorderQuery);

                int reorderCounter = 1;
                foreach (var detail in allDetails.Entities.OrderBy(e => e.GetAttributeValue<int>("new_linenumber")))
                {
                    bool isStarting = detail.Contains("new_recordstarting") && detail.GetAttributeValue<bool>("new_recordstarting");
                    if (isStarting && reorderCounter != 1)
                    {
                        reorderCounter++;
                        continue; // skip updating recordstarting = true
                    }

                    detail["new_linenumber"] = reorderCounter++;
                    service.Update(detail);
                }
            }
            catch (Exception ex)
            {
                throw new InvalidPluginExecutionException($"Plugin error: {ex.Message}", ex);
            }
        }

        public class QuoteDetailInput
        {
            public string QuoteDetailName { get; set; }
            public string ProductName { get; set; }
            public string ProductNumber { get; set; }
            public decimal PricePerUnit { get; set; }
            public int Quantity { get; set; }
            public int LineNumber { get; set; }
            public string Quote { get; set; }
        }
    }
}
